# Copy to .env for backend runtime configuration. Never commit real secrets.
APP_ENV=development
API_PREFIX=/api/v1

# PostgreSQL connection (SQLAlchemy 2 URL). Supabase is the shared/runtime DB.
# Supabase runtime (transaction pooler, IPv4):
# DATABASE_URL=postgresql+psycopg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Supabase migrations (direct/session pooler when direct IPv6 unavailable):
# MIGRATION_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Default local development database (SQLite file under backend/storage/):
DATABASE_URL=sqlite:///./storage/mcx_gold_dev.db

# CORS: explicit frontend origins only; never "*" with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Read-only source data root (relative paths resolved from repo root).
MCX_DATA_DIR=../GoldMcx_Data

# Fixed guard: source roots are opened read-only. Do not change.
DATA_WRITE_MODE=read_only

LOG_LEVEL=INFO
IMPORT_MAX_FILE_MB=50

# Whether the frontend may fall back to local demo data when the API is down.
DEMO_FALLBACK_ENABLED=true

# ---- Distributed cache (optional; leave unset in dev) ----------------
# REDIS_URL=redis://localhost:6379/0

# ---- Market data providers ------------------------------------------
# Real-time entitlements must be bought for live data; adapters must never run
# without credentials. See docs/providers.md.
# MARKET_DATA_PROVIDER=truedata          # truedata | accelpix (mcx_direct: licensed feed only)
# PUBLIC_MARKET_DATA_DISPLAY=false      # set true ONLY with redistribution approval recorded
# LIVE_FEED_ENABLED=true                # dedicated feed worker in this process

# TrueData Market Data API (official docs: https://www.truedata.in)
# TRUEDATA_LOGIN_ID=
# TRUEDATA_PASSWORD=
# TRUEDATA_LIVE_PORT=8082
# TRUEDATA_LIVE_URL=push.truedata.in
# TRUEDATA_AUTH_URL=https://auth.truedata.in/token
# TRUEDATA_HISTORY_URL=https://history.truedata.in

# AccelPix PIX API (official docs: https://support.accelpix.com)
# ACCELPIX_API_KEY=
# ACCELPIX_API_HOST=apidata.accelpix.in
# ACCELPIX_SCHEME=https

# MCX official EOD channel (distinct from a licensed real-time feed)
# MCX_EOD_ENABLED=false
# MCX_BHAVCOPY_BASE=https://www.mcxindia.com/backup/bhavcopy/BhavCopy_MCX_

# Freshness thresholds (seconds)
# LIVE_FEED_STALE_AFTER_S=8
# LIVE_QUOTE_CACHE_TTL_S=2
