# Copy to .env for backend runtime configuration. Never commit real secrets.
APP_ENV=development
API_PREFIX=/api/v1

# PostgreSQL connection when a server is available (SQLAlchemy 2 URL):
# DATABASE_URL=postgresql+psycopg://mcx_app:change-me@localhost:5432/mcx_gold
# Default local development database (SQLite file under backend/storage/):
DATABASE_URL=sqlite:///./storage/mcx_gold_dev.db

# CORS: explicit frontend origins only; never "*" with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Read-only source data root (relative paths resolved from repo root).
MCX_DATA_DIR=../GoldMcx_Data

# Fixed guard: source roots are opened read-only. Do not change.
DATA_WRITE_MODE=read_only

LOG_LEVEL=INFO
IMPORT_MAX_FILE_MB=50

# Whether the frontend may fall back to local demo data when the API is down.
DEMO_FALLBACK_ENABLED=true
